<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelRoot"
    android:layout_width="320dp"
    android:layout_height="match_parent"
    android:background="@drawable/panel_background"
    android:elevation="8dp"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="0dp">

    <LinearLayout
        android:id="@+id/panelHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/moodLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Mood"
            android:textColor="#6B7280"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/toneButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="8dp"
            android:text="Auto ▾"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="✕" />
    </LinearLayout>

    <!-- Tone options expand inside the panel (a Spinner popup can't take
        focus in a non-focusable overlay window, so it would never open).
        Only this button toggles it — the rest of the header stays draggable. -->
    <LinearLayout
        android:id="@+id/toneOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

    <TextView
        android:id="@+id/chatLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#6B7280"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/moodText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Paste or open a chat to begin."
        android:textColor="#6B7280"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/chatToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="💬 Chat"
        android:textColor="@color/ink"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/chatScroll"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginTop="4dp">

        <LinearLayout
            android:id="@+id/chatRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/summaryToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="📋 Summary"
        android:textColor="@color/ink"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/summaryScroll"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="4dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/summaryRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- First open of a chat: pick what to generate. Hidden after a choice. -->
    <LinearLayout
        android:id="@+id/chooserBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/chooseOpeners"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generate openers" />

        <Button
            android:id="@+id/choosePuns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Generate name puns" />

        <Button
            android:id="@+id/chooseReplies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Generate reply suggestions" />

        <Button
            android:id="@+id/chooseLearn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Learn &amp; load older messages first" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/suggestionList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Footer: version (inline, left of Learn), Learn, Refresh and the
         resize grip on one row. Sized to fit the 320dp panel. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="v?"
            android:textColor="#9CA3AF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnLearn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Learn" />

        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:contentDescription="Refresh"
            android:src="@drawable/ic_refresh" />

        <TextView
            android:id="@+id/resizeHandle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="2dp"
            android:paddingBottom="8dp"
            android:text="◢"
            android:textColor="#9CA3AF"
            android:textSize="16sp" />
    </LinearLayout>

</LinearLayout>
