# Choose ONE provider by setting its key. If both are set, LLM_PROVIDER
# decides; if neither LLM_PROVIDER nor this auto-detection applies, OpenAI
# is used by default. See lib/llm.ts for the exact resolution logic.

# --- Option A: OpenAI (or any OpenAI-compatible endpoint) ---
OPENAI_API_KEY=
# Optional: override default model (defaults to gpt-4o-mini in code)
OPENAI_MODEL=gpt-4o-mini
# Optional: point at any OpenAI-compatible endpoint instead of OpenAI directly.
# Handy for free testing without an OpenAI billing account — e.g. OpenRouter
# (https://openrouter.ai) offers free-tier models with no billing required:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1/chat/completions
#   OPENAI_API_KEY=<your OpenRouter key>
#   OPENAI_MODEL=meta-llama/llama-3.1-8b-instruct:free
# Leave blank to use OpenAI's endpoint directly.
OPENAI_BASE_URL=

# --- Option B: Anthropic (Claude) ---
# Just setting this key (with OPENAI_API_KEY left blank) is enough to switch
# providers automatically — no other changes needed.
ANTHROPIC_API_KEY=
# Optional: override default model (defaults to claude-haiku-4-5, the
# current fast/cheap tier). Use claude-sonnet-5 for higher-quality
# suggestions at higher cost. Anthropic retires older model IDs over time —
# check platform.claude.com/docs/en/about-claude/models if this 404s.
ANTHROPIC_MODEL=claude-haiku-4-5

# Optional: force a provider explicitly instead of relying on auto-detection
# above. Values: "openai" | "anthropic"
LLM_PROVIDER=

# Optional: analytics (PostHog). Leave blank to disable.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Free tier daily generation cap (client-enforced in v0, see lib/rateLimit.ts)
NEXT_PUBLIC_FREE_DAILY_LIMIT=5

# Optional: Supabase, for persistent feedback/waitlist/generation logging.
# Leave both blank to fall back to local .data/*.jsonl files (fine for local
# dev, not durable on serverless hosts). Server-side only — never prefix
# these with NEXT_PUBLIC_, the service role key must never reach the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
